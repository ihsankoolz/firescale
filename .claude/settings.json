{
  "permissions": {
    "allow": [
      "Bash(pnpm --silent fscale verify *)",
      "Bash(pnpm --silent fscale check *)",
      "Bash(pnpm --silent fscale facts *)",
      "Bash(pnpm --silent fscale doctor *)",
      "Bash(pnpm --silent fscale explain *)",
      "Bash(pnpm run build *)",
      "Bash(pnpm run lint *)",
      "Bash(pnpm run typecheck *)",
      "Bash(pnpm run test *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --silent fscale hooks run --agent claude"
          }
        ]
      }
    ]
  }
}
