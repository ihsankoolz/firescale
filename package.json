{
  "name": "firescale-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "Workspace root for firescale, a conformance and verify engine for any repo.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "cargo build --workspace && pnpm -r run build",
    "test": "pnpm run test:rust && pnpm run test:ts",
    "test:ts": "vitest run",
    "test:rust": "cargo test --workspace",
    "lint": "pnpm run lint:ts && pnpm run lint:format && pnpm run lint:rust",
    "lint:ts": "eslint .",
    "lint:format": "prettier --check .",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write . && cargo fmt --all",
    "fscale": "cargo run --quiet --package firescale-cli --"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
