// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`fscale init --packs core,supabase > builds a starter where the supabase pack reports no violations (snapshots) > package.json 1`] = `
"{
  "name": "supabase-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  },
  "devDependencies": {
    "supabase": "3.1.0"
  }
}
"
`;

exports[`fscale init --packs core,supabase > builds a starter where the supabase pack reports no violations (snapshots) > supabase/.gitignore 1`] = `
"# Supabase
.branches
.temp

# dotenvx
.env.keys
.env.local
.env.*.local
"
`;

exports[`fscale init --packs core,supabase > builds a starter where the supabase pack reports no violations (snapshots) > supabase/config.toml 1`] = `
"#:schema https://supabase.com/schemas/config/v1.json
# Supabase CLI settings: https://supabase.com/docs/guides/local-development/cli/config
# A setting not written here takes the CLI's default.

# Names the local containers: keep it unique among your projects.
project_id = "supabase-app"
"
`;

exports[`fscale init --packs core,supabase > builds a starter where the supabase pack reports no violations (snapshots) > supabase/tests/database/rls_test.sql 1`] = `
"-- Every table in the public schema has row level security on: the database
-- the migrations build, checked by \`supabase test db\` (pgTAP).
begin;
select plan(1);

select is_empty(
  $$ select tablename::text from pg_catalog.pg_tables
     where schemaname = 'public' and not rowsecurity $$,
  'every table in public has row level security enabled'
);

select * from finish();
rollback;
"
`;
