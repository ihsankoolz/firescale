{
  "name": "@firescale/native",
  "version": "0.1.0",
  "private": true,
  "description": "Native bindings for the firescale Rust core (built with napi-rs).",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "napi": {
    "binaryName": "firescale",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --esm"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12"
  }
}
