exports[`fscale hooks install > writes a hook file for each of the three agents > claude 1`] = `
"{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fscale hooks run --agent claude"
          }
        ]
      }
    ]
  }
}
"
`;

