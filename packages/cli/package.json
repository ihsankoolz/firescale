{
  "name": "firescale",
  "version": "0.1.3",
  "description": "Knock the scale off a repo, and prove it's clean. The npm package for the fscale CLI: config helpers and the Node host for TypeScript rules.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihsankoolz/firescale.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "fscale": "./bin/fscale.js",
    "firescale": "./bin/fscale.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": "./dist/host.js",
    "./schemas/check-output.schema.json": "./schemas/check-output.schema.json",
    "./schemas/facts-output.schema.json": "./schemas/facts-output.schema.json",
    "./schemas/verify-output.schema.json": "./schemas/verify-output.schema.json"
  },
  "files": [
    "bin",
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@firescale/sdk": "workspace:*"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
