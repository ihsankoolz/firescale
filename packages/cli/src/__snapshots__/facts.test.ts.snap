exports[`fscale facts > in a repo with projects in subfolders > prints the projects for people 1`] = `
"Package managers: npm, pip
Lockfiles: none
Languages: javascript, python, typescript
Tools: docker-compose, github-actions
Commands at the repo root:
  none
Projects (6):
  audit_service [python] backend/audit_service
    stack: python, pip, alembic, docker, pytest
    test: python -m pytest
  auth_service [python] backend/auth_service
    stack: python, pip, alembic, docker, pytest, ruff
    test: python -m pytest
    lint: python -m ruff check .
  frontend [node] frontend
    stack: javascript, typescript, npm, knip, oxlint, playwright, vite
    lockfiles: package-lock.json
    build: npm run build
    lint: npx --no oxlint
    typecheck: npx --no tsc --noEmit
  ledger_service [python] backend/ledger_service
    stack: python, pip, alembic, docker, pytest
    test: python -m pytest
  market_service [python] backend/market_service
    stack: python, pip, alembic, docker, pytest
    test: python -m pytest
  realtime_service [python] backend/realtime_service
    stack: python, pip, alembic, docker, pytest
    test: python -m pytest
"
`;

