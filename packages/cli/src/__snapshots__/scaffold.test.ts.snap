// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`fscale adopt > --dry-run prints a diff and changes nothing; adopt then leaves no deterministic violation 1`] = `
"Repo root: <root>

firescale
  would create firescale.config.json

--- /dev/null
+++ b/firescale.config.json
@@ -0,0 +1,3 @@
+{
+  "packs": ["core"]
+}

core/ci-exists
  would create .github/workflows/ci.yml (and stage it with git add)

--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,110 @@
+# Created by firescale (core/ci-exists). \`fscale sync\` replaces this file
+# with a newer one only while it is exactly as firescale wrote it (the
+# digest on the last line says so). Once you edit it, it is yours, and
+# firescale never rewrites it.
+name: CI
+
+on:
+  pull_request:
+  # Only for the tamper-guard job, which runs no code of the pull request.
+  pull_request_target:
+  push:
+    branches: [<branch>]
+
+permissions:
+  contents: read
+
+# A new push to a pull request cancels its run in progress. Each push
+# to a branch has a group of its own, so it is never cancelled: it
+# keeps the shared cache up to date.
+concurrency:
+  group: ci-\${{ github.event_name }}-\${{ github.event.pull_request.number || github.run_id }}
+  cancel-in-progress: \${{ github.event_name != 'push' }}
+
+jobs:
+  # Pull requests: only the projects the change reaches, judged against
+  # the base branch. This job restores caches and can never save them.
+  pull-request:
+    if: github.event_name == 'pull_request'
+    runs-on: ubuntu-latest
+    cache-mode: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          # The whole history, so the merge base with the base branch is here.
+          fetch-depth: 0
+      - id: image
+        run: echo "id=\${ImageOS:-unknown}-\${ImageVersion:-unknown}" >> "$GITHUB_OUTPUT"
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
+        with:
+          node-version: 24
+          # Its cache saves in a post step; the caches below are explicit.
+          package-manager-cache: false
+      - id: firescale-cache
+        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: .firescale/shared
+          key: firescale-steps-\${{ runner.os }}-\${{ steps.image.outputs.id }}-\${{ hashFiles('.github/workflows/ci.yml') }}-\${{ github.sha }}
+          restore-keys: firescale-steps-\${{ runner.os }}-\${{ steps.image.outputs.id }}-\${{ hashFiles('.github/workflows/ci.yml') }}-
+      # Runs check, lint, typecheck and test.
+      # The base is the one GitHub's event names, not a ref in the clone.
+      - run: npx firescale verify --affected --pr-base --jobs 2 --shared-cache .firescale/shared
+
+  # Pushes: everything. On the default branch it also saves the caches
+  # that pull requests restore.
+  default-branch:
+    if: github.event_name == 'push'
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          # The whole history, so the merge base with the base branch is here.
+          fetch-depth: 0
+      - id: image
+        run: echo "id=\${ImageOS:-unknown}-\${ImageVersion:-unknown}" >> "$GITHUB_OUTPUT"
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
+        with:
+          node-version: 24
+          # Its cache saves in a post step; the caches below are explicit.
+          package-manager-cache: false
+      - id: firescale-cache
+        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: .firescale/shared
+          key: firescale-steps-\${{ runner.os }}-\${{ steps.image.outputs.id }}-\${{ hashFiles('.github/workflows/ci.yml') }}-\${{ github.sha }}
+          restore-keys: firescale-steps-\${{ runner.os }}-\${{ steps.image.outputs.id }}-\${{ hashFiles('.github/workflows/ci.yml') }}-
+      # Runs check, lint, typecheck and test.
+      - run: npx firescale verify --jobs 2 --shared-cache .firescale/shared
+      # Saved from the default branch only: what pull requests may trust.
+      # Not saved when it holds just what was restored.
+      - uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        if: \${{ !cancelled() && github.ref_name == github.event.repository.default_branch && hashFiles('.firescale/shared/*.json') != '' && !endsWith(steps.firescale-cache.outputs.cache-matched-key, hashFiles('.firescale/shared/*.json')) }}
+        with:
+          path: .firescale/shared
+          key: firescale-steps-\${{ runner.os }}-\${{ steps.image.outputs.id }}-\${{ hashFiles('.github/workflows/ci.yml') }}-\${{ hashFiles('.firescale/shared/*.json') }}
+
+  # The tamper guard. On pull_request_target GitHub runs this job as the
+  # base branch's copy of this file has it, so a pull request cannot edit
+  # or remove it. It runs no code from the pull request: it checks out the
+  # base branch, fetches the pull request's commits as git objects, and
+  # compares them with the base GitHub names. Keep it that way: never check
+  # out the pull request's files here, install them or run them.
+  tamper-guard:
+    if: github.event_name == 'pull_request_target'
+    runs-on: ubuntu-latest
+    cache-mode: none
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+      - run: git fetch --no-tags origin "$HEAD_SHA"
+        env:
+          HEAD_SHA: \${{ github.event.pull_request.head.sha }}
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
+        with:
+          node-version: 24
+          package-manager-cache: false
+      - run: npx --yes firescale@0.4.0 tamper --pr-base
+# firescale-workflow: <digest>

core/gitignore-basics
  would create .gitignore

--- /dev/null
+++ b/.gitignore
@@ -0,0 +1,2 @@
+# Generated files and dependencies
+node_modules/

core/readme-setup
  would create README.md (and stage it with git add)

--- /dev/null
+++ b/README.md
@@ -0,0 +1,13 @@
+# bare
+
+<!-- A skeleton created by firescale (core/readme-setup). It is your team's to edit. -->
+
+## Install
+
+Describe how to install the project here.
+
+## Usage
+
+\`\`\`sh
+npm run test
+\`\`\`

Dry run: 4 changes. Nothing was changed. Run \`fscale adopt\` to apply.

Left for you afterwards: 2 violations that a fix cannot repair. A person or an agent has to.
  core/scripts-present
    package.json: package.json has no "build" script. Add a "build" entry to "scripts" that runs this project's build command. [agent-fixable]
    package.json: package.json has no "lint" script. Add a "lint" entry to "scripts" that runs this project's lint command. [agent-fixable]
    How to fix: fscale explain core/scripts-present

To review afterwards:
  core/ci-exists: Review .github/workflows/ci.yml: it runs \`npx firescale verify\` (only what a pull request changes, against its base) and keeps a shared step cache written from the default branch only. Add anything your project needs before that step (services, secrets, other toolchains).
  core/readme-setup: README.md is a skeleton. Describe the project and complete the Install and Usage sections.
"
`;

